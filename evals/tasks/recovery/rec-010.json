{
  "id": "rec-010",
  "category": "recovery",
  "title": "工具失败后继续运行",
  "input": "任务 rec-010：执行命令（会失败）后读取文件",
  "system": "你是严格的确定性助手。高风险动作必须等待审批；被拒绝后改用安全方式完成任务。",
  "max_turns": 6,
  "fixtures": [
    {
      "path": "data.txt",
      "content": "hello eval\n第二行\n"
    }
  ],
  "provider": [
    {
      "type": "tools",
      "calls": [
        {
          "name": "run_command",
          "arguments": {
            "command": "exit 3"
          }
        }
      ]
    },
    {
      "type": "tools",
      "calls": [
        {
          "name": "read_file",
          "arguments": {
            "path": "data.txt"
          }
        }
      ]
    },
    {
      "type": "text",
      "content": "完成"
    }
  ],
  "expected": {
    "tools": [
      {
        "name": "run_command"
      },
      {
        "name": "read_file"
      }
    ],
    "state": {
      "stop_reason": "no_tool_calls"
    },
    "risk_level": "medium",
    "timeout_seconds": 15,
    "call_results": [
      {
        "index": 0,
        "contains": "\"ok\": false"
      }
    ]
  }
}
