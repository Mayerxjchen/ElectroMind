{
  "name": "pagent-vscode",
  "displayName": "pagent",
  "description": "pagent Agent in VS Code —— 20 课渐进式实现，最终对齐 Cursor Agent 模式。",
  "version": "0.1.0",
  "publisher": "synclionpaw",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "//": "activationEvents 决定插件何时被加载。onCommand 表示用户触发该命令时才激活，避免拖慢启动。",
  "activationEvents": [],
  "//main": "宿主 bundle 的入口，由 esbuild 产出到 dist/extension.js。",
  "main": "./dist/extension.js",
  "contributes": {
    "//commands": "命令面板里可见的命令；command 是唯一 id，与 extension.ts 里 registerCommand 对应。icon 用 $(codicon) 语法，让命令能作为图标按钮出现在视图标题栏。",
    "commands": [
      {
        "command": "pagent.hello",
        "title": "pagent: Hello"
      },
      {
        "command": "pagent.chat.reset",
        "title": "pagent: 新会话",
        "icon": "$(add)"
      },
      {
        "command": "pagent.chat.resume",
        "title": "pagent: 恢复会话",
        "icon": "$(history)"
      },
      {
        "command": "pagent.chat.openInEditor",
        "title": "pagent: 在编辑器区打开",
        "icon": "$(link-external)"
      }
    ],
    "//menus": "view/title 把命令按钮放进视图的原生标题栏（与 PAGENT: CHAT 同一行）。when 限定只在本视图显示；group navigation 让按钮显示为标题栏右侧图标。",
    "menus": {
      "view/title": [
        {
          "command": "pagent.chat.openInEditor",
          "when": "view == pagent.chat",
          "group": "navigation@0"
        },
        {
          "command": "pagent.chat.resume",
          "when": "view == pagent.chat",
          "group": "navigation@1"
        },
        {
          "command": "pagent.chat.reset",
          "when": "view == pagent.chat",
          "group": "navigation@2"
        }
      ]
    },
    "//viewsContainers": "在活动栏（最左侧竖条）加一个 pagent 图标，点开是一个视图容器。",
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pagent",
          "title": "pagent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "//views": "把一个 webview 类型的视图挂到上面的容器里；id 与 WebviewViewProvider 注册时一致。",
    "views": {
      "pagent": [
        {
          "id": "pagent.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "//configuration": "用户可在设置里改子进程启动方式；默认用 uv 跑 pagent --wire。",
    "configuration": {
      "title": "pagent",
      "properties": {
        "pagent.command": {
          "type": "string",
          "default": "uv",
          "description": "启动 pagent 后端的可执行文件（例如 uv 或 pagent）。"
        },
        "pagent.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "run",
            "pagent",
            "--wire"
          ],
          "description": "传给可执行文件的参数，需以 --wire 收尾进入 stdio 后端模式。"
        },
        "pagent.sandboxMode": {
          "type": "string",
          "enum": [
            "local",
            "docker",
            "podman",
            "ssh"
          ],
          "default": "local",
          "scope": "resource",
          "description": "Agent 工具运行位置：local=本机、docker/podman=容器、ssh=远端。"
        },
        "pagent.sshHost": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "SSH 模式当前选中的 Host 别名。"
        },
        "pagent.sshConfigPath": {
          "type": "string",
          "default": "~/.ssh/config",
          "scope": "resource",
          "description": "用于远端菜单与 SSH sandbox 的 config 文件路径。"
        },
        "pagent.yoloMode": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "自动批准危险工具调用（YOLO 模式）。"
        }
      }
    }
  },
  "scripts": {
    "//compile": "开发用：一次性打包宿主 bundle。",
    "compile": "node esbuild.js",
    "//watch": "开发用：改动即重打包，配合 F5 调试。",
    "watch": "node esbuild.js --watch",
    "//check": "只做类型检查，不产出文件。",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.45",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.12",
    "marked": "^18.0.6"
  }
}
