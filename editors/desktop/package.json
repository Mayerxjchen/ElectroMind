{
    "name": "electromind-desktop",
    "productName": "electromind Desktop",
    "version": "0.8.0",
    "description": "electromind 的 Electron 桌面端骨架。",
    "private": true,
    "main": "dist/main.js",
    "scripts": {
        "compile": "node esbuild.js",
        "check": "tsc --noEmit",
        "test:layout": "node --test scripts/renderer-layout.test.mjs",
        "test:layout-geometry": "node --test scripts/layout-geometry.test.mjs",
        "test:skills-state": "node --test scripts/skills-state.test.mjs",
        "test:execution-context-state": "node --test scripts/execution-context-state.test.mjs",
        "test:file-api-unsupported": "node --test scripts/file-api-unsupported.test.mjs",
        "test:ipc-contract": "node --test scripts/ipc-contract.test.mjs",
        "start": "npm run compile && electron --no-sandbox --disable-gpu .",
        "package": "node scripts/package.js",
        "generate-icons": "cd assets && python3 -m venv .venv && .venv/bin/pip install -q Pillow && .venv/bin/python3 generate_icons.py",
        "test:inspector-state": "node --test scripts/inspector-state.test.mjs",
        "test:timeline-projection": "node --test scripts/timeline-projection.test.mjs",
        "test:threadstore-timeline": "node --test scripts/threadstore-timeline.test.mjs",
        "test:threadstore-restore": "node --test scripts/threadstore-restore.test.mjs",
        "test:renderer-timeline": "node --test scripts/message-renderer-timeline.test.mjs",
        "test:composer-permissions": "node --test scripts/composer-permissions.test.mjs",
        "test:composer-delivery": "node --test scripts/composer-delivery.test.mjs",
        "test:command-registry": "node --test scripts/command-registry.test.mjs",
        "test:model-policy": "node --test scripts/model-policy.test.mjs",
        "test:slash-parser": "node --test scripts/slash-parser.test.mjs",
        "test:composer-status": "node --test scripts/composer-status.test.mjs",
        "test:parser-unverified": "node --test scripts/parser-unverified.test.mjs",
        "test:agent-process-tree": "node --test scripts/agent-process-tree.test.mjs",
        "test:threadstore-singleton": "node --test scripts/threadstore-singleton.test.mjs",
        "test:package-agent": "node --test scripts/package-agent.test.mjs",
        "test:cdp-smoke": "node --test scripts/cdp-smoke.test.mjs",
        "test:features": "node --test scripts/features.test.mjs"
    },
    "devDependencies": {
        "@electron/packager": "^18.3.6",
        "@types/node": "^24.0.15",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "electron": "^37.10.3",
        "esbuild": "^0.25.8",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "@vscode/codicons": "^0.0.45",
        "dompurify": "^3.2.6",
        "highlight.js": "^11.11.1",
        "lucide": "^1.24.0",
        "marked": "^16.2.1",
        "qrcode": "^1.5.4",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "zustand": "^5.0.14"
    }
}
