{
  "attribution": {
    "commit": "Co-authored-by: Claude <claude@anthropic.com>"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ruff check . --fix 2>/dev/null || true",
            "statusMessage": "Fixing linting issues...",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$1\" | grep -q 'git commit'; then uv run ruff check . --fix 2>/dev/null; fi",
            "shell": "bash",
            "if": "Bash(git commit*)",
            "statusMessage": "Checking and fixing linting issues before commit..."
          }
        ]
      }
    ]
  }
}
